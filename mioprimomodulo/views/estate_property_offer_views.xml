<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_estate_property_offer" model="ir.actions.act_window">
        <field name="name">Offerte</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>

<!-- gestione della vista lista -->
    <record id="estate_property_offer_view_tree" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Offer list" editable="bottom" decoration-danger="status=='refused'" decoration-success="status=='accepted'">  <!-- editable="bottom" -->
                <field name="price"/>
                <field name="partner_id"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <button name="action_accepted" type="object" title="offer accepted" icon="fa-check" invisible="status == 'accepted' or status == 'refused'"/> <!-- name="action_confirm" string="Confirm" states="draft" type="object" icon="fa-check" -->
                <button name="action_refused" type="object" title="offer refused" icon="fa-times" invisible="status == 'refused' or status == 'accepted'"/>
                <button name="action_offer_test" type="object" title="offer test" icon="fa-apple"/>
                <!-- <field name="status"/> -->              
            </list>
        </field>
    </record>

<!-- gestione della vista form -->
    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Offer form">  <!-- editable="bottom" -->
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="partner_id"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <field name="status"/>
                        <!-- <field name="property_id"/> -->
                    </group>
                </sheet>              
            </form>
        </field>
    </record>

</odoo>