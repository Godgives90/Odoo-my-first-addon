<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="name">Immobili</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_disponibili': True}</field>
    </record>

<!-- gestione della vista kanban -->
    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban string="Estate property kanban" 
                    class="o_kanban_mobile" 
                    sample="1"
                    records_draggable="False"
                    default_group_by="property_type_id"
                    groups_draggable="True">
                <field name="title"/>
                <field name="expected_price"/>
                <field name="best_price"/>
                <field name="selling_price"/>
                <field name="tag_ids"/>
                <field name="state" widget="statusbar" statusbar_visible="new,offer received,offer accepted,sold"/>
                <templates>
                    <t t-name="card">
                        <div>
                            <div>
                                <strong>
                                    <field name="title"/>
                                </strong>
                            </div>
                            <div>Prezzo previsto:
                                <field name="expected_price"/>
                            </div>
                            <div t-if="record.state.raw_value == 'offer received'">Offerta migliore:
                                <field name="best_price"/>
                            </div>
                            <div t-if="record.state.raw_value == 'offer accepted'">Prezzo di vendita
                                <field name="selling_price"/>
                            </div>
                            <div>
                                <field name="tag_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record> 
            
<!-- gestione della vista lista -->
    <record id="estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Channel" decoration-success="state=='offer received' or state=='offer accepted'" 
            decoration-bf="state=='offer accepted'" decoration-muted="state=='sold'">  <!-- editable="bottom" -->
                <field name="title"/>
                <field name="property_type_id"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability" optional="hide"/>
            </list>
        </field>
    </record>

<!-- gestione della vista form -->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate property form"> 
                <header>
                    <button name="action_sold" type="object" string="Venduto" invisible="state == 'sold' or state == 'canceled'"/>
                    <button name="action_canceled" type="object" string="Annullato" invisible="state == 'sold' or state == 'canceled'"/>
                    <button name="action_test" type="object" string="Test"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer received,offer accepted,sold"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title"/></h1>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <separator/> 
                    </div>
                    <group>
                        <group>
                            <field name="state"/>
                            <field name="property_type_id" options="{'no_create' : True}"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                            <field name="company_id"/>
                        </group>                            
                    </group>
                    <notebook>
                        <page string="Caratteristiche">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" invisible="not garden"/>
                                <field name="garden_orientation" invisible="not garden"/>
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page string="Offerte">
                            <field name="offer_ids" readonly="state == 'offer accepted' or state == 'sold' or state == 'canceled'"/>
                        </page>
                        <page string="Altre info">
                            <group>
                                <field name="salesperson_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

<!-- campi di ricerca, filtri e gruppi -->
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Estate property">
                <field name="title" />
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" filter_domain="[('living_area', '>=', self)]"/>
                <field name="facades"/>
                <field name="property_type_id"/>
                <separator/>
                <filter string="Disponibili" name="disponibili" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer received')]" help="Mostra solo le proprietà disponibili"/>
                <group expand="1" string="Group By">
                    <filter string="Codice postale" name="postcode" context="{'group_by':'postcode'}"/> <!-- , 'residual_visible':True -->
                </group>
            </search>
        </field>
    </record> 

</odoo>