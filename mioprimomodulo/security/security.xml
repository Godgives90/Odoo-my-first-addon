<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_estate_property" model="ir.module.category">
        <field name="name">Beni immobiliari</field>
        <field name="sequence">1</field>
    </record>

    <record id="estate_group_user" model="res.groups">
        <field name="name">Agente</field>
        <field name="category_id" ref="base.module_category_real_estate_brokerage"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="estate_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="base.module_category_real_estate_brokerage"/>
        <field name="implied_ids" eval="[(4, ref('mioprimomodulo.estate_group_user'))]"/>
    </record>

    <record id="estate_group_admin" model="res.groups">
        <field name="name">Amministratore</field>
        <field name="category_id" ref="base.module_category_real_estate_brokerage"/>
        <field name="implied_ids" eval="[(4, ref('mioprimomodulo.estate_group_manager'))]"/>
    </record>

    <record id="estate_rule_user" model="ir.rule">
        <field name="name">Agent records domain</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="groups" eval="[Command.link(ref('mioprimomodulo.estate_group_user'))]"/>
        <field name="domain_force">['&amp;', '|', ('company_id', 'in', company_ids), ('company_id', '=', False),
                                             '|', ('salesperson_id', '=', user.id), ('salesperson_id', '=', False)]</field>   
    </record>

    <record id="estate_rule_manager" model="ir.rule">
        <field name="name">Manager records domain</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="groups" eval="[Command.link(ref('mioprimomodulo.estate_group_manager'))]"/>
        <field name="domain_force">['|', ('salesperson_id', '!=', False), ('salesperson_id', '=', False)]</field>
    </record>

    <!--<record id="estate_multicomp_rule_agent" model="ir.rule">
        <field name="name">Manager multicompany records domain</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="groups" eval="[Command.link(ref('mioprimomodulo.estate_group_user'))]"/>
        <field name="domain_force">[
            '|', ('company_id', 'in', company_ids), ('company_id', '=', False)
        ]</field>
    </record>-->

</odoo>